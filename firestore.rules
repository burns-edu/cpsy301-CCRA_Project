rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Events — anyone can read, only admins can write
    match /events/{event} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products — anyone can read, only admins can write
    match /products/{product} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sponsors — anyone can read active ones, only admins can write
    match /sponsors/{sponsor} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users — each user reads/writes their own doc; admins can read all
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Contact messages — anyone can create, only admins can read
    match /messages/{message} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
